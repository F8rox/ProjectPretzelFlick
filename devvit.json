{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "pretzelflick",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "PretzelFlick: tracked shows",
        "description": "Add or remove tracked anime",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/tracked-open"
      },
      {
        "label": "PretzelFlick: settings",
        "description": "Posting options",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/settings-open"
      },
      {
        "label": "PretzelFlick: check now",
        "description": "Sync tracked shows with AniList",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/sync-now"
      },
      {
        "label": "PretzelFlick: recent activity",
        "description": "What was posted, skipped, or failed",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/activity-open"
      },
      {
        "label": "PretzelFlick: post next episode now",
        "description": "Post the next tracked episode without waiting for its job",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-next"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "pretzelflick_dev2"
  },
  "permissions": {
    "http": {
      "domains": [
        "graphql.anilist.co"
      ]
    },
    "reddit": true,
    "redis": true
  },
  "scheduler": {
    "tasks": {
      "daily-sync": {
        "endpoint": "/internal/scheduler/daily-sync",
        "cron": "0 4 * * *"
      },
      "post-episode": {
        "endpoint": "/internal/scheduler/post-episode"
      }
    }
  },
  "forms": {
    "trackedForm": "/internal/form/tracked-submit",
    "pickForm": "/internal/form/pick-submit",
    "settingsForm": "/internal/form/settings-submit",
    "activityForm": "/internal/form/activity-submit"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "thread.html",
        "height": "regular"
      }
    }
  }
}
