{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "pretzelflick",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "PretzelFlick: test airing post",
        "description": "Posts one test thread from AniList",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/test-airing-post"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "pretzelflick_dev2"
  },
  "permissions": {
    "http": {
      "domains": [
        "graphql.anilist.co"
      ]
    },
    "reddit": true,
    "redis": true
  },
  "scheduler": {
    "tasks": {
      "airing-check": {
        "endpoint": "/internal/scheduler/airing-check",
        "cron": "*/10 * * * *"
      }
    }
  }
}
